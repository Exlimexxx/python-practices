# Пример переменных окружения. Скопируйте в .env и задайте реальные значения.
# Файл .env в репозиторий не добавляется (см. .gitignore).
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///instance/hotel.db
# Для PostgreSQL: postgresql+psycopg://user:password@localhost:5432/hotel
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SQL_ECHO=0
HOST=127.0.0.1
PORT=5015
SEED_DEMO=1
