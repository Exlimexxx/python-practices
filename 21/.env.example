# Пример конфигурации. Скопируйте файл в .env и замените значения.
# .env не попадает в Git и в контекст сборки Docker.

# Приложение
APP_NAME=Hotel Booking API
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_MINUTES=60

# Секреты (обязательно заменить)
JWT_SECRET=change-me-strong-jwt-secret-32-bytes-min
ADMIN_EMAIL=admin@hotel.ru
ADMIN_PASSWORD=admin-pass-12345

# Локальный запуск без Docker
DATABASE_URL=sqlite:///./data/hotel.db

# PostgreSQL для docker compose
POSTGRES_DB=hotel
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=change-me-strong-db-password
