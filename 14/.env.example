# Пример переменных окружения (п. 41 методички)
APP_ENV=development
DATABASE_URL=sqlite:///./movies.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/movies
REDIS_URL=redis://localhost:6379/0
# auto | memory | redis
CACHE_BACKEND=auto
CACHE_TTL=60
LOG_LEVEL=INFO
DEFAULT_LIMIT=20
MAX_LIMIT=100
